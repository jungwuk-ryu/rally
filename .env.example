# Optional. Rally continues with prepared MC lines when this is absent or fails.
GEMINI_API_KEY=

# Optional. The default host password is 123456.
HOST_PASSWORD=

# Optional. Upbit's public ticker needs no credential. These remain server-only
# for a future private integration and must never use a VITE_ prefix.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
